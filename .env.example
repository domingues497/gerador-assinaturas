# Copie os valores para /etc/gerador-assinaturas.env no Ubuntu.
# Gere uma chave aleatória; não comite o arquivo real.
GERADOR_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LONGA_ALEATORIA

# Necessário para integração do suplemento Outlook; preencher somente após configurar o Entra ID.
GERADOR_ENTRA_TENANT_ID=
GERADOR_ENTRA_CLIENT_ID=
GERADOR_ENTRA_AUDIENCE=
# Opcional se o emissor do token não for o padrão v2.
# GERADOR_ENTRA_ISSUER=https://login.microsoftonline.com/SEU_TENANT_ID/v2.0
